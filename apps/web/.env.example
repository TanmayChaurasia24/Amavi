# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/settle?sslmode=require

# ─── PayPal (Sandbox ONLY) ─────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX

# Webhook ID from PayPal Developer Dashboard
PAYPAL_WEBHOOK_ID=your_webhook_id

# Set to "false" during local dev verification before ngrok / webhook registration
PAYPAL_WEBHOOK_VERIFY=true

# ─── App ───────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000

# ─── Auth (Log in with PayPal & Sessions) ──────────────────────────────────────
# Generate with: openssl rand -hex 32 (min 32 characters)
SESSION_SECRET=your_min_32_char_random_session_secret_here
# Must match a registered Return URL in your PayPal Sandbox app settings
PAYPAL_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/paypal/callback

# ─── AI (Phase 3) ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── PayPal Sandbox Buyer Email (for verification scripts) ──────────────────────
PAYPAL_BUYER_EMAIL=your_sandbox_buyer_email@personal.example.com

# ─── Email Channel (Resend) ────────────────────────────────────────────────────
# Optional real email channel via Resend (off by default)
EMAIL_CHANNEL_ENABLED=false
RESEND_API_KEY=re_your_resend_api_key
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
INBOUND_EMAIL_DOMAIN=inbound.settle.app
EMAIL_FROM=Settle Collections <notifications@settle.app>
MAX_AGENT_REPLIES_PER_INVOICE_PER_DAY=5

